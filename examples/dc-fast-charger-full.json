      "currentVersion": "4.1.0",
      "updateMethods": ["ota-ocpp", "ota-vendor-cloud", "usb"]
    },
    "protocols": [
      {
        "name": "OCPP",
        "version": "2.0.1",
        "transport": ["json", "websocket"],
        "securityProfile": "3 - TLS with Client Certificates",
        "profiles": ["Core", "SmartCharging", "FirmwareManagement", "ISO15118Support", "TariffAndCost", "DisplayMessage"],
        "certifications": [
          {
            "type": "protocol-conformance",
            "standard": "OCPP 2.0.1 Certification",
            "certificateNumber": "OCA-2091",
            "issuingBody": "Open Charge Alliance",
            "issueDate": "2025-06-01"
          }
        ],
        "configuration": [
          {
            "key": "HeartbeatInterval",
            "dataType": "integer",
            "defaultValue": 60,
            "minValue": 10,
            "maxValue": 3600,
            "unit": "s",
            "readOnly": false,
            "rebootRequired": false,
            "description": "Interval between OCPP Heartbeat messages sent to the CSMS."
          }
        ]
      },
      {
        "name": "ISO15118",
        "version": "ISO 15118-20:2022",
        "transport": ["xml", "tcp"],
        "profiles": ["Plug&Charge", "Bidirectional Power Transfer"],
        "certifications": [
          {
            "type": "cybersecurity",
            "standard": "ISO/IEC 15118-20 Security",
            "certificateNumber": "TUV-2025-77012",
            "issuingBody": "TUV SUD",
            "issueDate": "2025-05-15",
            "jurisdiction": "EU"
          }
        ]
      },
      {
        "name": "OCPI",
        "version": "2.2.1",
        "transport": ["https"],
        "profiles": ["locations", "sessions", "cdrs", "tariffs", "commands"]
      }
    ],
    "smartCharging": {
      "features": ["local-load-balancing", "backend-managed-profiles", "dynamic-pricing", "v2g"],
      "scheduleTypes": ["absolute", "recurring-daily", "relative"]
    },
    "configuration": [
      {
        "key": "MaxTotalOutputPower",
        "dataType": "number",
        "defaultValue": 150,
        "minValue": 50,
        "maxValue": 150,
        "unit": "kW",
        "readOnly": false,
        "rebootRequired": true,
        "description": "Site-configurable cap on combined output power across both connectors."
      }
    ],
    "integration": {
      "webUI": true,
      "localInterfaces": ["http", "modbus", "webhooks"],
      "apiDocumentationUrl": "https://ionwave.example/docs/integration-api"
    },
    "offlineChargingSupported": true,
    "operatingSystem": "Linux 6.1 (Yocto)"
